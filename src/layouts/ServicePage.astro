---
/**
 * Shared chrome for the service pages. The body of each page is written by
 * hand — a templated service page reads as templated, which is what the whole
 * exercise is trying to get away from.
 */
import Layout from './Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import { business, telHref, whatsappHref } from '../config/business';

interface Props {
  title: string;
  description: string;
  h1: string;
  lede: string;
  /** Service key, so the page's own card is left out of the "other services" grid. */
  serviceKey: string;
}

const { title, description, h1, lede, serviceKey } = Astro.props;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: business.url + '/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: h1,
      item: new URL(Astro.url.pathname, business.url).href,
    },
  ],
};
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner">
        <nav class="breadcrumbs" aria-label="Firimituri">
          <a href="/">Acasă</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{h1}</span>
        </nav>
        <h1 class="page-hero__title">{h1}</h1>
        <p class="page-hero__lede">{lede}</p>
        <div class="page-hero__actions">
          <a href={telHref} class="btn btn--primary btn--lg">Sună la {business.phone.display}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
            Trimite fotografii pe WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <article class="prose">
      <slot />
    </article>
  </div>

  <CtaBand />

  <section class="services" style="padding-top:56px">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Celelalte servicii</h2>
      </div>
      <ServicesGrid exclude={serviceKey} />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>
