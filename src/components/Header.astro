---
import { business, telHref } from '../config/business';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/instalatii-sanitare-suceava/', label: 'Sanitare' },
  { href: '/instalatii-termice-suceava/', label: 'Termice' },
  { href: '/montaj-aer-conditionat-suceava/', label: 'Aer condiționat' },
  { href: '/lucrari/', label: 'Lucrări' },
  { href: '/despre/', label: 'Despre' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="header" id="site-header">
  <div class="header__inner">
    <a href="/" class="header__brand" aria-label={`${business.name} — Acasă`}>
      <img src="/logo-192.png" alt="" width="192" height="192" class="header__logo" />
      <div class="header__brand-text">
        <span class="header__name">{business.name}</span>
        <span class="header__tagline">{business.tagline}</span>
      </div>
    </a>

    <nav id="nav-principal" class="header__nav" aria-label="Navigare principală">
      <ul class="header__links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="header__link"
                aria-current={pathname === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={telHref} class="btn btn--primary header__nav-cta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Sună acum
      </a>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="header__burger"
      aria-label="Deschide meniul"
      aria-expanded="false"
      aria-controls="nav-principal"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div id="nav-backdrop" class="header__backdrop" hidden></div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const nav = document.getElementById('nav-principal')!;
  const burger = document.getElementById('nav-toggle')!;
  const backdrop = document.getElementById('nav-backdrop')!;
  const mobile = window.matchMedia('(max-width: 899px)');

  let open = false;

  function setOpen(next: boolean) {
    open = next;
    nav.classList.toggle('header__nav--open', open);
    burger.classList.toggle('header__burger--open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Închide meniul' : 'Deschide meniul');
    backdrop.hidden = !open;
    document.body.style.overflow = open && mobile.matches ? 'hidden' : '';
    if (open) nav.querySelector('a')?.focus();
  }

  burger.addEventListener('click', () => setOpen(!open));
  backdrop.addEventListener('click', () => setOpen(false));
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) {
      setOpen(false);
      burger.focus();
    }
  });

  // Keep Tab inside the open panel, otherwise focus walks the page behind it.
  nav.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !open || !mobile.matches) return;
    const items = nav.querySelectorAll<HTMLElement>('a, button');
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Resizing past the breakpoint while open would strand a fixed panel on desktop.
  mobile.addEventListener('change', () => {
    if (!mobile.matches && open) setOpen(false);
  });

  window.addEventListener(
    'scroll',
    () => header.classList.toggle('header--scrolled', window.scrollY > 20),
    { passive: true },
  );
</script>
