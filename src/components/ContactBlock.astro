---
/**
 * Contact details, rendered from config so the phone number and hours can never
 * drift between the homepage, the contact page and the structured data.
 *
 * The 2.8 MB decorative map (7291x4166) that used to sit here is gone. It cost
 * a quarter of the page weight, showed nothing useful, and pointed at what was
 * probably a private address.
 */
import { business, telHref, whatsappHref, mailtoHref } from '../config/business';
---

<div class="contact__grid">
  <div class="contact__info">
    <div class="contact__card">
      <div class="contact__card-icon contact__card-icon--orange">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </div>
      <div>
        <h3 class="contact__card-title">Telefon</h3>
        <a href={telHref} class="contact__card-value">{business.phone.display}</a>
        <p class="contact__card-note">Cel mai rapid mod de a mă găsi</p>
      </div>
    </div>

    <div class="contact__card">
      <div class="contact__card-icon contact__card-icon--blue">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
      </div>
      <div>
        <h3 class="contact__card-title">WhatsApp</h3>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="contact__card-value">
          {business.phone.display}
        </a>
        <p class="contact__card-note">Trimiteți fotografii cu problema — vă spun ce se poate face</p>
      </div>
    </div>

    <div class="contact__card">
      <div class="contact__card-icon contact__card-icon--navy">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>
      <div>
        <h3 class="contact__card-title">Email</h3>
        <a href={mailtoHref} class="contact__card-value">{business.email}</a>
        <p class="contact__card-note">Pentru oferte și documente</p>
      </div>
    </div>

    <div class="contact__card">
      <div class="contact__card-icon contact__card-icon--navy">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <h3 class="contact__card-title">Program</h3>
        {business.hours.map((h) => (
          <p class="contact__card-value">{h.label}: {h.opens} – {h.closes}</p>
        ))}
        <p class="contact__card-note">{business.hoursNote}</p>
      </div>
    </div>
  </div>
</div>
