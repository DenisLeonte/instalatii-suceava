---
import { business, telHref, whatsappHref } from '../config/business';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Discutăm lucrarea?',
  text = 'Sunați sau trimiteți-mi câteva fotografii pe WhatsApp. Vă spun ce se poate face și cât costă, înainte să încep.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container">
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="cta-band__actions">
      <a href={telHref} class="btn btn--primary btn--lg">Sună la {business.phone.display}</a>
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
        Trimite fotografii pe WhatsApp
      </a>
    </div>
  </div>
</section>
