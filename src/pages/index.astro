---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ServicesGrid from '../components/ServicesGrid.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ContactBlock from '../components/ContactBlock.astro';
import {
  business,
  telHref,
  whatsappHref,
} from '../config/business';
import { featuredProjects } from '../config/portfolio';
import pardoseala from '../assets/pardoseala.png';

const title = 'Instalator Suceava – Instalații sanitare și termice';
const description = `Instalator în Suceava cu ${business.yearsExperience} ani experiență. Instalații sanitare, termice, aer condiționat și piscine. Deviz înainte de lucrare, garanție ${business.warranty.months} luni.`;

const faq = [
  {
    q: 'Cât costă o lucrare?',
    a: `Prețul depinde de lucrare — de la o reparație de câteva ore la o instalație completă. Vin, văd exact ce este de făcut și vă dau un deviz înainte să încep. Nu începeți nicio lucrare fără să știți cât costă.`,
  },
  {
    q: 'În ce zone vă deplasați?',
    a: `Lucrez în ${business.serviceArea.base} și în împrejurimi, pe o rază de până la ${business.serviceArea.radiusKm} km. Pentru lucrări mai mari mă deplasez și mai departe — sunați și discutăm.`,
  },
  {
    q: 'Puteți verifica pe unde pierde casa căldură?',
    a: 'Da. Folosesc o cameră termică pentru a identifica zonele cu pierderi de căldură, de exemplu în jurul ferestrelor, ușilor, pereților sau tavanelor. Verificarea se face când există o diferență suficientă de temperatură între interior și exterior.',
  },
  {
    q: 'Oferiți garanție?',
    a: `Da, ${business.warranty.months} luni pentru lucrările pe care le execut. Dacă apare o problemă care ține de manopera mea, revin și o rezolv.`,
  },
  {
    q: 'Interveniți în regim de urgență?',
    a: 'Sâmbăta lucrez. Noaptea nu preiau intervenții — prefer să vă spun asta direct decât să nu răspund la telefon. Dacă este ceva urgent, sunați dimineața devreme și încerc să vă prind în program.',
  },
  {
    q: 'Cum vă pot trimite detalii despre problemă?',
    a: 'Cel mai simplu este pe WhatsApp: faceți câteva fotografii cu instalația și trimiteți-mi-le. De multe ori îmi dau seama din poze ce trebuie făcut și ce materiale să aduc.',
  },
];
---

<Layout title={title} description={description}>
  <section id="acasa" class="hero">
    <div class="hero__bg">
      <div class="hero__gradient"></div>
      <div class="hero__pattern"></div>
    </div>

    <div class="hero__layout">
      <div class="hero__inner">
        <div class="hero__badge">
          {business.serviceArea.base} și împrejurimi · {business.yearsExperience} ani experiență
        </div>

        <h1 class="hero__title">
          Instalator în {business.serviceArea.base} pentru{' '}
          <span class="hero__title--water">instalații sanitare</span>{' '}
          <span class="hero__title--heat">și termice</span>
        </h1>

        <p class="hero__subtitle">
          Sunt {business.owner}, instalator în {business.serviceArea.base} de aproximativ {business.yearsExperience} ani.
          Execut instalații sanitare, termice, climatizare și piscine —
          în {business.serviceArea.base} și pe o rază de până la {business.serviceArea.radiusKm} km.
          Vin personal la fiecare lucrare, primiți devizul înainte să încep și ofer
          garanție {business.warranty.months} luni.
        </p>

        <div class="hero__actions">
          <a href={telHref} class="btn btn--primary btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 1 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Sună la {business.phone.display}
          </a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Trimite fotografii pe WhatsApp
          </a>
        </div>
      </div>

      <aside class="hero-process" aria-labelledby="hero-process-title">


        <ol class="hero-process__steps">
          <li class="hero-process__step hero-process__step--contact">
            <span class="hero-process__number" aria-hidden="true">01</span>
            <span class="hero-process__track" aria-hidden="true">
              <span class="hero-process__node"></span>
              <span class="hero-process__segment"></span>
            </span>
            <span class="hero-process__copy">
              <strong class="hero-process__title">Mă contactezi</strong>
              <small class="hero-process__detail">Telefon sau WhatsApp</small>
            </span>
          </li>

          <li class="hero-process__step hero-process__step--visit">
            <span class="hero-process__number" aria-hidden="true">02</span>
            <span class="hero-process__track" aria-hidden="true">
              <span class="hero-process__node"></span>
              <span class="hero-process__segment"></span>
            </span>
            <span class="hero-process__copy">
              <strong class="hero-process__title">Vin la locație</strong>
              <small class="hero-process__detail">Văd exact ce este de făcut</small>
            </span>
          </li>

          <li class="hero-process__step hero-process__step--estimate">
            <span class="hero-process__number" aria-hidden="true">03</span>
            <span class="hero-process__track" aria-hidden="true">
              <span class="hero-process__node"></span>
              <span class="hero-process__segment"></span>
            </span>
            <span class="hero-process__copy">
              <strong class="hero-process__title">Primești devizul</strong>
              <small class="hero-process__detail">Știi costul înainte să încep</small>
            </span>
          </li>

          <li class="hero-process__step hero-process__step--work">
            <span class="hero-process__number" aria-hidden="true">04</span>
            <span class="hero-process__track" aria-hidden="true">
              <span class="hero-process__node"></span>
            </span>
            <span class="hero-process__copy">
              <strong class="hero-process__title">Execut lucrarea</strong>
              <small class="hero-process__detail">Personal · garanție {business.warranty.months} luni</small>
            </span>
          </li>
        </ol>


      </aside>
    </div>
  </section>

  <section id="servicii" class="services">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Ce fac</span>
        <h2 class="section-title">Servicii</h2>
        <p class="section-subtitle">
          De la apă și canalizare la încălzire, climatizare, piscine și dedurizare —
          pentru case, apartamente, blocuri și spații comerciale.
        </p>
      </div>
      <ServicesGrid />
    </div>
  </section>

  <section id="lucrari" class="portfolio">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Lucrări</span>
        <h2 class="section-title">Câteva dintre lucrările mele</h2>
        <p class="section-subtitle">
          Fotografii din lucrări reale, executate în {business.serviceArea.base} și împrejurimi.
        </p>
      </div>
      <PortfolioGrid items={featuredProjects} />
      <p class="portfolio__more">
        <a href="/lucrari/" class="btn btn--outline">Vezi toate lucrările</a>
      </p>
    </div>
  </section>

  <section id="despre" class="about">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Despre mine</span>
        <h2 class="section-title">{business.owner}</h2>
      </div>
      <div class="about__content">
        <figure class="about__work">
          <Image
            src={pardoseala}
            alt="Instalație de încălzire în pardoseală executată înainte de turnarea șapei"
            widths={[480, 720, 960]}
            sizes="(max-width: 700px) calc(100vw - 32px), 38vw"
            class="about__work-image"
          />
          <figcaption>
            <strong>Lucrare reală</strong>
            <span>Încălzire în pardoseală, înainte de turnarea șapei</span>
          </figcaption>
        </figure>
        <div class="about__text">
          <p>
            Sunt {business.owner} și lucrez ca instalator în {business.serviceArea.base}{' '}
            de aproximativ {business.yearsExperience} ani. Lucrez împreună cu câțiva
            oameni de sprijin, însă vin personal la fiecare lucrare — de la prima
            discuție până la recepția finală.
          </p>
          <p>
            Am executat lucrări în case, apartamente, blocuri și spații comerciale.
            Discutăm întâi ce aveți nevoie, vă spun ce se poate face și cât costă,
            iar dacă sunteți de acord, mă apuc de treabă.
          </p>
          <p>
            <a href="/despre/" class="services__card-link">
              Mai multe despre mine
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="zone" class="area">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Zone deservite</span>
        <h2 class="section-title">Ajung și la tine?</h2>
      </div>
      <div class="area__box">
        <div class="area__facts">
          <dl>
            <div>
              <dt>Punct de plecare</dt>
              <dd>{business.serviceArea.base}</dd>
            </div>
            <div>
              <dt>Deplasare</dt>
              <dd>Până la {business.serviceArea.radiusKm} km</dd>
            </div>
          </dl>
        </div>
        <div class="area__copy">
          <h3>Spune-mi localitatea și ce lucrare ai nevoie.</h3>
          <p>
            Îți confirm direct dacă mă pot deplasa și când pot ajunge. Pentru lucrări
            mai mari merg și mai departe de zona obișnuită.
          </p>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline area__cta"
          >
            Verifică pe WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="intrebari" class="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Întrebări frecvente</span>
        <h2 class="section-title">Ce mă întreabă cel mai des clienții</h2>
      </div>
      <div class="faq__list">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Contact</span>
        <h2 class="section-title">Hai să discutăm lucrarea</h2>
        <p class="section-subtitle">
          Sunați sau trimiteți-mi fotografii pe WhatsApp. Vă răspund și vă spun
          ce se poate face.
        </p>
      </div>
      <ContactBlock />
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />
</Layout>
